{
  "uid": "otternet-wan",
  "title": "OTTERNET / WAN routing",
  "description": "The SR Linux routers, over gNMI, as the wan-routing profile selects. The series are the OpenConfig ones the fabric switches report, filtered to kind DcimDevice.",
  "tags": [
    "otternet",
    "telemetry",
    "wan"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "BGP sessions established per router",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by (device) (bgp_neighbor_session_state_code{kind=\"DcimDevice\"} == 6)",
          "instant": true,
          "range": false,
          "legendFormat": "{{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Sessions not established",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "bgp_neighbor_session_state_code{kind=\"DcimDevice\"} != 6",
          "instant": false,
          "range": true,
          "legendFormat": "{{device}} -> {{neighbor_address}} ({{name}})"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Interface throughput (bits/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (device, name) (rate(interface_counters_in_octets{kind=\"DcimDevice\", name=~\"ethernet-.*\"}[2m]) * 8)",
          "instant": false,
          "range": true,
          "legendFormat": "{{device}} {{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Control-plane CPU (%)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (device) (cpu_instant{kind=\"DcimDevice\"})",
          "instant": false,
          "range": true,
          "legendFormat": "{{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
