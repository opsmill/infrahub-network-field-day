    {
      "id": 5,
      "type": "stat",
      "title": "Cabled fabric links down",
      "description": "Switch interfaces a NetworkLink says are cabled and active, whose operational state is not up (or is not reported).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count((otternet_intended_interface_up{kind=\"DcimFabricSwitch\"} == 1) unless on (device, interface) (label_replace(interface_status_oper_status_code{kind=\"DcimFabricSwitch\"}, \"interface\", \"$1\", \"name\", \"(.*)\") == 1)) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "links": [
        {
          "title": "Fabric telemetry",
          "url": "/d/otternet-fabric-telemetry"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Firewall handoffs down",
      "description": "fw1 interfaces carrying a modelled description (the zone handoffs) whose ifOperStatus is not up.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(interface_ifOperStatus{kind=\"SecurityFirewall\", ifName=~\"(ge|xe)-[0-9]+/[0-9]+/[0-9]+\", ifAlias!=\"\"} != 1) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "links": [
        {
          "title": "Perimeter firewall",
          "url": "/d/otternet-perimeter"
