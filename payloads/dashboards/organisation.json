_vip unless on (namespace) kube_service_status_load_balancer_ingress) or count by (service_kind, service) (otternet_intended_service_probe unless on (service, port) (net_response_result_code == 0))), \"application\", \"$1\", \"service\", \"(.*)\")), \"check\", \"application\", \"\", \"\"))) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          },
          "noValue": "0"
