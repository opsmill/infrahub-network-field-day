    {
      "id": 9,
      "type": "bargauge",
      "title": "Devices by kind",
      "description": "One series per DcimGenericDevice in Infrahub, grouped by its kind.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by (kind) (label_replace(infrahub_dcimgenericdevice_info, \"kind\", \"$1\", \"hfid\", \"([A-Za-z]+)__.*\"))",
          "instant": true,
          "range": false,
          "legendFormat": "{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
