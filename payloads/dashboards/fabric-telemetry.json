                "interface",
                "peer_device",
                "peer_interface",
                "Value"
              ]
            }
          }
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Throughput per Ethernet port",
      "description": "Bits per second in (up) and out (down), every Ethernet port of the selected switches. Port-Channels are left out so a member's traffic is not counted twice.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (device, name) (rate(interface_counters_in_octets{kind=\"DcimFabricSwitch\", device=~\"$device\", name=~\"Ethernet.*\"}[$__rate_interval]) * 8)",
          "instant": false,
          "range": true,
          "legendFormat": "{{device}} {{name}} in"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (device, name) (rate(interface_counters_out_octets{kind=\"DcimFabricSwitch\", device=~\"$device\", name=~\"Ethernet.*\"}[$__rate_interval]) * 8)",
          "instant": false,
          "range": true,
          "legendFormat": "{{device}} {{name}} out"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* out$"
            },
            "properties": [
              {
                "id": "custom.transform",
                "value": "negative-Y"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Errors and discards",
      "description": "Packets per second dropped as errors or discards, in and out: the total across the selected switches, plus one line for each port whose rate is not zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 37,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
