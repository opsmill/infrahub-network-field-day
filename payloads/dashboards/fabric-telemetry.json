      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count((label_replace(label_replace(bgp_neighbor_session_state_code{kind=\"DcimFabricSwitch\", device=~\"$device\"}, \"peer_address\", \"$1\", \"neighbor_address\", \"(.*)\"), \"vrf\", \"$1\", \"name\", \"(.*)\") == 6) unless on (device, vrf, peer_address) otternet_intended_bgp_neighbor{kind=\"DcimFabricSwitch\", device=~\"$device\"}) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
