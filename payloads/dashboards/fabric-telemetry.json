                  "color": "orange",
                  "index": 5
                },
                "6": {
                  "text": "Not present",
                  "color": "red",
                  "index": 6
                },
                "7": {
                  "text": "Lower layer down",
                  "color": "red",
                  "index": 7
                }
              }
            }
