            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(interface_counters_in_errors{kind=\"DcimFabricSwitch\", device=~\"$device\", name=~\"Ethernet.*\"}[1h]) + increase(interface_counters_out_errors{kind=\"DcimFabricSwitch\", device=~\"$device\", name=~\"Ethernet.*\"}[1h]) + increase(interface_counters_in_discards{kind=\"DcimFabricSwitch\", device=~\"$device\", name=~\"Ethernet.*\"}[1h]) + increase(interface_counters_out_discards{kind=\"DcimFabricSwitch\", device=~\"$device\", name=~\"Ethernet.*\"}[1h])) or vector(0)",
          "instant": true,
          "range": false
        }
