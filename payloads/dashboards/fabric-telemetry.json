    {
      "id": 14,
      "type": "table",
      "title": "Every cabled interface and its operational state",
      "description": "One row per end of each NetworkLink on a switch, with the peer Infrahub records.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (device, interface, peer_device, peer_interface) (otternet_intended_link{kind=\"DcimFabricSwitch\", device=~\"$device\"} * 0 + on (device, interface) max by (device, interface) (label_replace(interface_status_oper_status_code{kind=\"DcimFabricSwitch\", device=~\"$device\"}, \"interface\", \"$1\", \"name\", \"(.*)\"))) or on (device, interface) max by (device, interface, peer_device, peer_interface) (otternet_intended_link{kind=\"DcimFabricSwitch\", device=~\"$device\"} * 0)",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not reported",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Up",
                  "color": "green",
                  "index": 1
                },
                "2": {
                  "text": "Down",
                  "color": "red",
                  "index": 2
                },
                "3": {
                  "text": "Testing",
                  "color": "orange",
                  "index": 3
                },
                "4": {
                  "text": "Unknown",
                  "color": "orange",
                  "index": 4
                },
                "5": {
