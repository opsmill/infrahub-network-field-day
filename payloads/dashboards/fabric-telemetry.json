    {
      "id": 13,
      "type": "stat",
      "title": "Interface errors and discards (1h)",
      "description": "In and out errors plus discards over the last hour, every fabric Ethernet port.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
