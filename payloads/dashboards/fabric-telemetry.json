          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Every BGP session: intended, observed, or both",
      "description": "One row per session Infrahub intends, with the state the switch reports (Not reported: the switch reports no session to that peer in that VRF), plus any session the switch holds that no structured config explains, marked unexplained. Problems sort first.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(max by (device, vrf, peer_address, peer_device) (otternet_intended_bgp_neighbor{kind=\"DcimFabricSwitch\", device=~\"$device\"} * 0 + on (device, vrf, peer_address) max by (device, vrf, peer_address) (label_replace(label_replace(bgp_neighbor_session_state_code{kind=\"DcimFabricSwitch\", device=~\"$device\"}, \"peer_address\", \"$1\", \"neighbor_address\", \"(.*)\"), \"vrf\", \"$1\", \"name\", \"(.*)\"))) or on (device, vrf, peer_address) max by (device, vrf, peer_address, peer_device) (otternet_intended_bgp_neighbor{kind=\"DcimFabricSwitch\", device=~\"$device\"} * 0), \"intent\", \"intended\", \"\", \"\") or label_replace(max by (device, vrf, peer_address) (label_replace(label_replace(bgp_neighbor_session_state_code{kind=\"DcimFabricSwitch\", device=~\"$device\"}, \"peer_address\", \"$1\", \"neighbor_address\", \"(.*)\"), \"vrf\", \"$1\", \"name\", \"(.*)\") unless on (device, vrf, peer_address) otternet_intended_bgp_neighbor{kind=\"DcimFabricSwitch\", device=~\"$device\"}), \"intent\", \"UNEXPLAINED\", \"\", \"\")",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not reported",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Idle",
                  "color": "red",
                  "index": 1
                },
                "2": {
                  "text": "Connect",
                  "color": "orange",
                  "index": 2
                },
                "3": {
                  "text": "Active",
                  "color": "orange",
                  "index": 3
                },
                "4": {
                  "text": "OpenSent",
                  "color": "orange",
                  "index": 4
                },
                "5": {
                  "text": "OpenConfirm",
                  "color": "orange",
                  "index": 5
                },
                "6": {
                  "text": "Established",
                  "color": "green",
                  "index": 6
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "State"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "custom.width",
                "value": 140
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "State",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "device": 0,
              "vrf": 1,
              "peer_address": 2,
              "peer_device": 3,
              "intent": 4,
              "Value": 5
            },
            "renameByName": {}
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "device",
                "vrf",
                "peer_address",
                "peer_device",
                "intent",
                "Value"
              ]
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "EVPN routes received per leaf",
      "description": "L2VPN EVPN prefixes received, summed over each leaf's overlay neighbours (OpenConfig afi-safi prefixes).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (device) (bgp_afi_safi_received{kind=\"DcimFabricSwitch\", afi_safi_name=\"L2VPN_EVPN\", device=~\"$device\"})",
          "instant": false,
          "range": true,
          "legendFormat": "{{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "IPv4 unicast prefixes received per switch",
