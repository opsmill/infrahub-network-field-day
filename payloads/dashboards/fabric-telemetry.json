{
  "uid": "otternet-fabric-telemetry",
  "title": "OTTERNET / Fabric telemetry",
  "description": "Streaming telemetry from the fabric, collected exactly as Infrahub's monitoring profiles say -- and compared with what Infrahub intends.",
  "tags": [
    "otternet",
    "telemetry",
    "fabric"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 7,
      "type": "stat",
      "title": "Intended BGP sessions",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(otternet_intended_bgp_neighbor)",
          "instant": true,
          "range": false
        }
      ],
      "description": "Every session Infrahub's intent says should exist, from the stored structured configs and the modelled WAN neighbours.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Intended but not established",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(otternet_intended_bgp_neighbor unless on (device, peer_address) (label_replace(bgp_neighbor_session_state_code == 6, \"peer_address\", \"$1\", \"neighbor_address\", \"(.*)\") or label_replace(frr_bgp_peer_state == 1, \"peer_address\", \"$1\", \"peer\", \"(.*)\"))) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "description": "0 is healthy. Anything else is a session Infrahub intends that the device does not report as established.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Established but never intended",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count((label_replace(bgp_neighbor_session_state_code == 6, \"peer_address\", \"$1\", \"neighbor_address\", \"(.*)\") or label_replace(frr_bgp_peer_state == 1, \"peer_address\", \"$1\", \"peer\", \"(.*)\")) unless on (device, peer_address) otternet_intended_bgp_neighbor) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "description": "0 is healthy. Anything else is a session up on a device that no intent explains.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 1,
      "type": "table",
      "title": "Which sessions are down",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "otternet_intended_bgp_neighbor unless on (device, peer_address) (label_replace(bgp_neighbor_session_state_code == 6, \"peer_address\", \"$1\", \"neighbor_address\", \"(.*)\") or label_replace(frr_bgp_peer_state == 1, \"peer_address\", \"$1\", \"peer\", \"(.*)\"))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "description": "Sessions Infrahub configures that the device does not report as established.",
      "fieldConfig": {
        "defaults": {
          "noValue": "All intended sessions are established"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "table",
      "title": "Which sessions are unexplained",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(label_replace(bgp_neighbor_session_state_code == 6, \"peer_address\", \"$1\", \"neighbor_address\", \"(.*)\") or label_replace(frr_bgp_peer_state == 1, \"peer_address\", \"$1\", \"peer\", \"(.*)\")) unless on (device, peer_address) otternet_intended_bgp_neighbor",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "description": "The other half: a session up on the device that no intent explains.",
      "fieldConfig": {
        "defaults": {
          "noValue": "Every established session is intended"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Interface throughput (bits/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (device, name) (rate(interface_counters_in_octets{kind=\"DcimFabricSwitch\"}[2m]) * 8)",
          "instant": false,
          "range": true,
          "legendFormat": "{{device}} {{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Interface errors",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (device, name) (rate(interface_counters_in_errors{kind=\"DcimFabricSwitch\"}[5m]))",
          "instant": false,
          "range": true,
          "legendFormat": "{{device}} {{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Cabled interfaces Infrahub expects up",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(otternet_intended_interface_up)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Devices reporting, by kind",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by (kind) (count by (device, kind) ({job=\"telemetry\", kind!=\"\"}))",
          "instant": true,
          "range": false,
          "legendFormat": "{{kind}}"
        }
      ],
      "description": "Every target here came from a monitoring profile; none is listed by hand.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
