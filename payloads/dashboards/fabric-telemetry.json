          },
          "expr": "sum(rate(interface_counters_in_errors{kind=\"DcimFabricSwitch\", device=~\"$device\"}[$__rate_interval]) + rate(interface_counters_out_errors{kind=\"DcimFabricSwitch\", device=~\"$device\"}[$__rate_interval]) + rate(interface_counters_in_discards{kind=\"DcimFabricSwitch\", device=~\"$device\"}[$__rate_interval]) + rate(interface_counters_out_discards{kind=\"DcimFabricSwitch\", device=~\"$device\"}[$__rate_interval]))",
          "instant": false,
          "range": true,
          "legendFormat": "all ports"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (device, name) (rate(interface_counters_in_errors{kind=\"DcimFabricSwitch\", device=~\"$device\"}[$__rate_interval]) + rate(interface_counters_out_errors{kind=\"DcimFabricSwitch\", device=~\"$device\"}[$__rate_interval]) + rate(interface_counters_in_discards{kind=\"DcimFabricSwitch\", device=~\"$device\"}[$__rate_interval]) + rate(interface_counters_out_discards{kind=\"DcimFabricSwitch\", device=~\"$device\"}[$__rate_interval])) > 0",
          "instant": false,
          "range": true,
          "legendFormat": "{{device}} {{name}}"
