# Rendered by Infrahub for {{ node }} -- do not edit.
#
# ISP customer-facing PE, AS {{ isp.asn }}.
#
# Every TENANT terminates in its own VRF here, and this is the only device
# where tenant routes, DC routes and the internet all meet, so it is the only
# place isolation has to be enforced.
#
# How a tenant reaches what it is entitled to, and nothing else:
#
#   1. each site of the tenant lands in VRF CUST_x -- an eBGP session for a
#      `kind: bgp` site, a static route for a `kind: static` one
#   2. the default network instance imports VRF CUST_x, so the DC and the
#      internet learn a route back
#   3. VRF CUST_x imports the default network instance -- but through
#      RM-<TENANT>-IMPORT, which accepts the shared DC services, the own cloud
#      subnet of that tenant
#
# Step 3 is the whole design. The prefixes of EVERY tenant are in the default
# instance after step 2; without the per-tenant policy, step 3 would hand each
# tenant the routes of the others and the provider would be transiting between them.
#
# Steps 2 and 3 are SR Linux inter-instance route leaking: the import policy
# under `inter-instance-policies` decides which routes of the OTHER instances
# a network instance takes, matched on `origin-network-instance`. That is the
# equivalent of `import vrf` in FRR, and like it, a leaked route is never
# leaked onward.
#
# Comments in this file carry no quote characters, deliberately: sr_cli
# tokenises quotes before it recognises a comment, so one apostrophe swallows
# every line up to the next one and those lines are silently never applied.
#
# Note what step 1 does NOT need: anything to make the sites of a tenant reach
# each other. Two sites of one tenant share a VRF, so hq and dr have a route to one
# another the moment both are up. Site-to-site connectivity is a consequence of
# the tenant model, not a feature bolted onto it.
{% include "_system.srl.j2" %}
{% include "_interfaces.srl.j2" %}
{% for t in tenants %}
{% for site in t.sites if site.kind == 'static' %}
#
# {{ t.name }}/{{ site.name }} is statically routed -- no protocol with this CE at
# all. The route lives in the VRF and is exported into BGP below, which is
# what makes it indistinguishable from the eBGP sites downstream.
set / network-instance {{ t.vrf }} next-hop-groups group {{ t.name }}-{{ site.name }} nexthop 1 ip-address {{ site.ce.wan_address | replace('/30','') }}
set / network-instance {{ t.vrf }} static-routes route {{ site.lan }} next-hop-group {{ t.name }}-{{ site.name }}
{% endfor %}
{% endfor %}
#
# ---- the shared half of what a tenant may learn -------------------------
# DC services every tenant may reach.
{% for p in isp.dc_service_prefixes %}
set / routing-policy prefix-set PL-DC-SERVICES prefix {{ p }} mask-length-range exact
{% endfor %}
{% if isp.internet is defined %}
set / routing-policy prefix-set PL-DEFAULT prefix 0.0.0.0/0 mask-length-range exact
{% endif %}
#
# ---- per-tenant import policy -------------------------------------------
# Shared DC services, plus the own cloud subnet of this tenant. Anything else in the provider instance -- which
# includes every other tenant -- is rejected.
{% for t in tenants %}
set / routing-policy prefix-set PL-{{ t.name | upper }}-CLOUD prefix {{ t.dc.subnet }} mask-length-range exact
# shared DC services
set / routing-policy policy RM-{{ t.name | upper }}-IMPORT statement 10 match origin-network-instance default
set / routing-policy policy RM-{{ t.name | upper }}-IMPORT statement 10 match prefix prefix-set PL-DC-SERVICES
set / routing-policy policy RM-{{ t.name | upper }}-IMPORT statement 10 action policy-result accept
# the own isolated cloud subnet of {{ t.name }}
set / routing-policy policy RM-{{ t.name | upper }}-IMPORT statement 20 match origin-network-instance default
set / routing-policy policy RM-{{ t.name | upper }}-IMPORT statement 20 match prefix prefix-set PL-{{ t.name | upper }}-CLOUD
set / routing-policy policy RM-{{ t.name | upper }}-IMPORT statement 20 action policy-result accept
set / routing-policy policy RM-{{ t.name | upper }}-IMPORT default-action policy-result reject
{% endfor %}
#
# ---- what each site is allowed to announce to us ------------------------
# A site may only originate its own assigned prefix. Without this a CE could
# announce a default route, the LAN of another tenant, or that of its own
# sibling site, and the provider would believe it.
{% for t in tenants %}
{% for site in t.sites if site.kind == 'bgp' %}
set / routing-policy prefix-set PL-{{ t.name | upper }}-{{ site.name | upper }}-IN prefix {{ site.lan }} mask-length-range exact
set / routing-policy policy RM-{{ t.name | upper }}-{{ site.name | upper }}-IN statement 10 match prefix prefix-set PL-{{ t.name | upper }}-{{ site.name | upper }}-IN
set / routing-policy policy RM-{{ t.name | upper }}-{{ site.name | upper }}-IN statement 10 action policy-result accept
set / routing-policy policy RM-{{ t.name | upper }}-{{ site.name | upper }}-IN default-action policy-result reject
{% endfor %}
{% endfor %}
#
# ---- route leaking: what each instance offers ---------------------------
# SR Linux leaks only routes their OWN instance has marked leakable, through
# an inter-instance export policy; the importing instance then chooses among
# them. Both halves are needed. An import policy on its own leaks nothing and
# reports nothing -- measured: every session up, every tenant VRF empty.
#
# Each instance offers its BGP and static routes. Connected PE-CE subnets
# stay where they are, as they did under FRR, which never leaked them either.
set / routing-policy policy LEAKABLE statement 10 match protocol bgp
set / routing-policy policy LEAKABLE statement 10 action policy-result accept
set / routing-policy policy LEAKABLE statement 20 match protocol static
set / routing-policy policy LEAKABLE statement 20 action policy-result accept
set / routing-policy policy LEAKABLE default-action policy-result reject
#
# ---- step 2: the routes of every tenant, into the provider instance -----
# So the DC and the internet can route back.
{% for t in tenants %}
set / routing-policy policy IMPORT-TENANT-VRFS statement {{ loop.index * 10 }} match origin-network-instance {{ t.vrf }}
set / routing-policy policy IMPORT-TENANT-VRFS statement {{ loop.index * 10 }} action policy-result accept
{% endfor %}
set / routing-policy policy IMPORT-TENANT-VRFS default-action policy-result reject
#
# ---- what each BGP table holds ------------------------------------------
# A leaked route is in the route table and NOT in BGP, so BGP never
# advertises it -- the second silent failure, measured as every session up
# and the core learning nothing but a loopback. `rib-management` with a
# `route-table-import` policy is what puts it into BGP, and once that is
# configured it is the ONLY way a non-BGP route enters BGP: the loopback and
# the static sites have to be named here too.
#
# These three policies are therefore the exact equivalent of the FRR
# `network`, `redistribute static` and `import vrf` lines, and nothing more.
set / routing-policy prefix-set PL-LOOPBACK prefix {{ isp.edge.loopback }}/32 mask-length-range exact
set / routing-policy policy BGP-TABLE-DEFAULT statement 10 match prefix prefix-set PL-LOOPBACK
set / routing-policy policy BGP-TABLE-DEFAULT statement 10 action policy-result accept
set / routing-policy policy BGP-TABLE-DEFAULT statement 20 match network-instance-leaked-route true
set / routing-policy policy BGP-TABLE-DEFAULT statement 20 action policy-result accept
set / routing-policy policy BGP-TABLE-DEFAULT default-action policy-result reject
{% for t in tenants %}
set / routing-policy policy BGP-TABLE-{{ t.vrf }} statement 10 match network-instance-leaked-route true
set / routing-policy policy BGP-TABLE-{{ t.vrf }} statement 10 action policy-result accept
{% if t.sites | selectattr('kind', 'equalto', 'static') | list %}
# The statically routed sites. This is what puts them into the BGP table of
# the tenant alongside the eBGP ones, so the DC, the internet and the other
# sites of the tenant all learn them the same way.
set / routing-policy policy BGP-TABLE-{{ t.vrf }} statement 20 match protocol static
set / routing-policy policy BGP-TABLE-{{ t.vrf }} statement 20 action policy-result accept
{% endif %}
set / routing-policy policy BGP-TABLE-{{ t.vrf }} default-action policy-result reject
{% endfor %}
#
# ---- what the core and the sites are told -------------------------------
# Everything in the BGP table, which is what FRR did with no outbound
# route-map. The table is already exactly what the policies above let in;
# filtering again here would be a second place to get it wrong.
set / routing-policy policy EXPORT-BGP-TABLE default-action policy-result accept
#
# ---- provider core: default network instance ----------------------------
# `ebgp-default-policy` false on both halves is `no bgp ebgp-requires-policy`
# in FRR terms: every session here carries an explicit policy, and none is
# refused for lacking one.
set / network-instance default inter-instance-policies apply-policy import-policy [ IMPORT-TENANT-VRFS ]
set / network-instance default inter-instance-policies apply-policy export-policy [ LEAKABLE ]
set / network-instance default protocols bgp autonomous-system {{ isp.asn }}
set / network-instance default protocols bgp router-id {{ isp.edge.loopback }}
set / network-instance default protocols bgp ebgp-default-policy import-reject-all false
set / network-instance default protocols bgp ebgp-default-policy export-reject-all false
set / network-instance default protocols bgp afi-safi ipv4-unicast admin-state enable
set / network-instance default protocols bgp rib-management table ipv4-unicast route-table-import BGP-TABLE-DEFAULT
set / network-instance default protocols bgp group core peer-as {{ isp.asn }}
set / network-instance default protocols bgp neighbor {{ isp.edge.core.peer }} peer-group core
set / network-instance default protocols bgp neighbor {{ isp.edge.core.peer }} description "isp-pe2 (core)"
# iBGP to a directly-connected peer: without next-hop-self the DC-bound next
# hop stays the customer-facing address, which pe2 cannot resolve.
set / network-instance default protocols bgp neighbor {{ isp.edge.core.peer }} next-hop-self true
set / network-instance default protocols bgp neighbor {{ isp.edge.core.peer }} export-policy [ EXPORT-BGP-TABLE ]
{% for t in tenants %}
#
# ==== tenant {{ t.name }} (VRF {{ t.vrf }}) ====
{% for site in t.sites %}
#   site {{ site.name }}: {{ site.lan }} via {{ site.ce.node }} ({{ site.kind }}{% if site.kind == 'bgp' %}, AS {{ site.asn }}{% endif %})
{% endfor %}
# Import the provider instance, filtered to what this tenant is entitled to.
# This is what keeps {{ t.name }} from seeing the other tenants.
set / network-instance {{ t.vrf }} inter-instance-policies apply-policy import-policy [ RM-{{ t.name | upper }}-IMPORT ]
set / network-instance {{ t.vrf }} inter-instance-policies apply-policy export-policy [ LEAKABLE ]
set / network-instance {{ t.vrf }} protocols bgp autonomous-system {{ isp.asn }}
set / network-instance {{ t.vrf }} protocols bgp router-id {{ isp.edge.loopback }}
set / network-instance {{ t.vrf }} protocols bgp ebgp-default-policy import-reject-all false
set / network-instance {{ t.vrf }} protocols bgp ebgp-default-policy export-reject-all false
set / network-instance {{ t.vrf }} protocols bgp afi-safi ipv4-unicast admin-state enable
set / network-instance {{ t.vrf }} protocols bgp rib-management table ipv4-unicast route-table-import BGP-TABLE-{{ t.vrf }}
{% for site in t.sites if site.kind == 'bgp' %}
set / network-instance {{ t.vrf }} protocols bgp group {{ t.name }}-{{ site.name }} peer-as {{ site.asn }}
set / network-instance {{ t.vrf }} protocols bgp neighbor {{ site.ce.wan_address | replace('/30','') }} peer-group {{ t.name }}-{{ site.name }}
set / network-instance {{ t.vrf }} protocols bgp neighbor {{ site.ce.wan_address | replace('/30','') }} description "{{ site.ce.node }} ({{ t.name }}/{{ site.name }})"
set / network-instance {{ t.vrf }} protocols bgp neighbor {{ site.ce.wan_address | replace('/30','') }} import-policy [ RM-{{ t.name | upper }}-{{ site.name | upper }}-IN ]
set / network-instance {{ t.vrf }} protocols bgp neighbor {{ site.ce.wan_address | replace('/30','') }} export-policy [ EXPORT-BGP-TABLE ]
{% endfor %}
{% endfor %}
{% include "_cpm_acl.srl.j2" %}
