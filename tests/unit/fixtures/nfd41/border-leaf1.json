  "custom_structured_configuration_route_maps": [
    {
      "name": "RM-CILIUM-IN",
      "sequence_numbers": [
        {
          "description": "Accept only sanctioned pod and service CIDRs",
          "match": [
            "ip address prefix-list PL-CILIUM-PERMITTED"
          ],
          "sequence": 10,
          "set": [
            "community 65101:110 additive"
          ],
          "type": "permit"
        },
        {
          "description": "Explicit deny - anything else is a policy violation",
          "sequence": 99,
          "type": "deny"
        }
      ]
    },
    {
      "name": "RM-WAN-IN",
      "sequence_numbers": [
        {
          "description": "Accept only assigned customer supernets",
          "match": [
            "ip address prefix-list PL-WAN-PERMITTED"
          ],
          "sequence": 10,
          "set": [
            "community 65103:50 additive"
          ],
          "type": "permit"
        },
        {
          "description": "Explicit deny - the provider announced something it should not",
          "sequence": 99,
          "type": "deny"
        }
      ]
    },
    {
      "name": "RM-BRANCH-IN",
      "sequence_numbers": [
        {
          "description": "Accept only the branch LAN",
          "match": [
            "ip address prefix-list PL-BRANCH-PERMITTED"
          ],
          "sequence": 10,
          "set": [
            "community 65103:70 additive"
          ],
          "type": "permit"
        },
        {
          "description": "Explicit deny",
          "sequence": 99,
          "type": "deny"
        }
      ]
    },
    {
      "name": "RM-DC-TO-BRANCH",
      "sequence_numbers": [
        {
          "description": "Advertise DC services and the node subnet to our own office",
          "match": [
            "ip address prefix-list PL-DC-ADVERTISED-BRANCH"
          ],
          "sequence": 10,
          "type": "permit"
        },
        {
          "description": "Explicit deny - still no pod CIDR, still no app tenant",
          "sequence": 99,
          "type": "deny"
        }
      ]
    },
    {
      "name": "RM-DC-TO-EXTERNAL",
      "sequence_numbers": [
        {
          "description": "Advertise the DC service VIP range only",
          "match": [
            "ip address prefix-list PL-DC-ADVERTISED"
          ],
          "sequence": 10,
          "type": "permit"
        },
        {
          "description": "Explicit deny - do not leak DC internals to the outside",
          "sequence": 99,
          "type": "deny"
        }
      ]
    },
    {
      "name": "RM-FABRIC-TO-CILIUM",
      "sequence_numbers": [
        {
          "description": "Default route and node subnet only",
          "match": [
            "ip address prefix-list PL-FABRIC-TO-CILIUM"
          ],
          "sequence": 10,
          "type": "permit"
        },
        {
          "sequence": 99,
          "type": "deny"
        }
      ]
    }
  ],
