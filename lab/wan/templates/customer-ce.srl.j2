# Rendered by wan/render.py for {{ node }} -- do not edit.
#
# {{ tenant.name }} / site {{ site.name }} CE, AS {{ site.asn }}.
#
# A customer edge router as a customer would actually run it: announce our own
# LAN, take what the provider gives us, and default toward the provider. It
# knows nothing about VRFs, the DC, the internet, or the other tenants --
# everything that makes this tenant isolated is enforced on the PE, not here,
# which is exactly why it is worth checking on the PE rather than trusting
# this file.
#
# Note it does not know about its own sibling site either. The other sites of
# {{ tenant.name }} appear here as ordinary routes learned from the provider, because they
# share a VRF on the PE.
{% include "_system.srl.j2" %}
{% include "_interfaces.srl.j2" %}
#
# Announce only our own LAN, so a fat-fingered export here cannot leak
# anything to the provider (which would refuse it anyway -- see
# RM-{{ tenant.name | upper }}-{{ site.name | upper }}-IN on isp-pe1).
set / routing-policy prefix-set PL-OUR-LAN prefix {{ site.lan }} mask-length-range exact
set / routing-policy policy RM-TO-ISP statement 10 match prefix prefix-set PL-OUR-LAN
set / routing-policy policy RM-TO-ISP statement 10 action policy-result accept
set / routing-policy policy RM-TO-ISP default-action policy-result reject
#
set / network-instance default protocols bgp autonomous-system {{ site.asn }}
set / network-instance default protocols bgp router-id {{ site.ce.lan_address | replace('/24','') }}
set / network-instance default protocols bgp ebgp-default-policy import-reject-all false
set / network-instance default protocols bgp ebgp-default-policy export-reject-all false
set / network-instance default protocols bgp afi-safi ipv4-unicast admin-state enable
set / network-instance default protocols bgp group provider peer-as {{ isp.asn }}
set / network-instance default protocols bgp neighbor {{ site.pe.address | replace('/30','') }} peer-group provider
set / network-instance default protocols bgp neighbor {{ site.pe.address | replace('/30','') }} description "{{ isp.edge.node }} (provider)"
set / network-instance default protocols bgp neighbor {{ site.pe.address | replace('/30','') }} export-policy [ RM-TO-ISP ]
{% include "_cpm_acl.srl.j2" %}
