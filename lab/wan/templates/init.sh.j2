#!/bin/bash
# Rendered by wan/render.py for {{ node }} -- do not edit.
#
# Runs as pid 1 and execs FRR at the end. It exists because FRR cannot create
# VRFs: zebra will configure an interface inside a VRF, but the VRF device
# itself has to be there already, and if it is not, the `vrf` stanzas in
# frr.conf are silently dropped and every customer session stays down.
#
# containerlab wires the veths a moment after the container starts, so this
# waits for them before touching anything.
set -eu

log() { echo "[wan-init:{{ node }}] $*"; }

wait_for() {
    local ifname="$1" waited=0
    while [ ! -e "/sys/class/net/$ifname" ]; do
        waited=$((waited + 1))
        if [ "$waited" -gt 600 ]; then
            log "FATAL: $ifname did not appear after 300s"
            exit 1
        fi
        [ $((waited % 60)) -eq 0 ] && log "still waiting for $ifname"
        sleep 0.5
    done
}

{% for i in interfaces %}
wait_for {{ i.name }}
{% endfor %}
log "all interfaces present"

# Routing, and no reverse-path filtering: traffic legitimately arrives on an
# interface other than the one the return route points at while BGP converges.
sysctl -qw net.ipv4.ip_forward=1
sysctl -qw net.ipv4.conf.all.rp_filter=0
sysctl -qw net.ipv4.conf.default.rp_filter=0

{% if vrfs %}
# ---- VRFs -----------------------------------------------------------------
{% for v in vrfs %}
ip link show {{ v.name }} >/dev/null 2>&1 || ip link add {{ v.name }} type vrf table {{ v.table }}
ip link set {{ v.name }} up
log "vrf {{ v.name }} (table {{ v.table }})"
{% endfor %}
{% endif %}

{% if bridges %}
# ---- LAN bridges ----------------------------------------------------------
# A site LAN is a shared segment. Without a bridge each host would sit on its
# own point-to-point link and two devices in the same /24 could not reach each
# other without the router proxy-ARPing for them -- which works right up until
# you look at a packet capture and wonder why the branch is routing traffic
# between two machines plugged into the same switch.
{% for b in bridges %}
ip link show {{ b.name }} >/dev/null 2>&1 || ip link add {{ b.name }} type bridge
ip link set {{ b.name }} mtu {{ mtu }}
ip addr replace {{ b.address }} dev {{ b.name }}
ip link set {{ b.name }} up
log "bridge {{ b.name }} -> {{ b.address }}"
{% endfor %}
{% endif %}

# ---- interfaces -----------------------------------------------------------
# Addresses are set here rather than in frr.conf so that the box is correct
# even if bgpd never starts -- which makes "is it the wiring or is it BGP?"
# answerable with one ping.
{% for i in interfaces %}
ip link set {{ i.name }} mtu {{ mtu }}
{% if i.vrf %}
ip link set {{ i.name }} master {{ i.vrf }}
{% endif %}
{% if i.bridge %}
ip link set {{ i.name }} master {{ i.bridge }}
{% endif %}
{% if i.address %}
ip addr replace {{ i.address }} dev {{ i.name }}
{% endif %}
ip link set {{ i.name }} up
log "{{ i.name }} -> {% if i.address %}{{ i.address }}{% else %}port on {{ i.bridge }}{% endif %}{% if i.vrf %} (vrf {{ i.vrf }}){% endif %}"
{% endfor %}
{% if loopback %}
ip addr replace {{ loopback }}/32 dev lo
log "loopback -> {{ loopback }}"
{% endif %}

# ---- get out of BGP's way -------------------------------------------------
# containerlab gives every node a default route via eth0 to the management
# bridge, and a kernel default beats a BGP-learned one. On a host that is
# harmless; on a ROUTER it means internet-bound traffic leaves through the
# management interface instead of through the provider, which presents as a
# routing-policy failure and is not one -- the policy is fine, the route is
# simply never used.
#
# Dropping it costs the container outbound internet access, which nothing here
# needs at runtime: containerlab reaches these nodes over the directly
# connected management subnet, and `make wan-deploy` uses docker exec.
if ip route show default dev eth0 | grep -q default; then
    ip route del default dev eth0 || true
    log "removed the management default route so BGP's can be used"
fi

# ---- the daemon sockets, shared with the frr_exporter sidecar ---------------
# /var/run/frr is a bind mount from the lab directory, so the sidecar (which
# shares this container's network namespace but not its filesystem) can read
# the daemons' vty sockets. Docker creates a missing bind source as root, and
# FRR runs as `frr`, so the directory is claimed before any daemon starts --
# otherwise bgpd cannot create its socket and the router comes up with no BGP.
install -d -o frr -g frr -m 0755 /var/run/frr

log "starting FRR"
exec /usr/lib/frr/docker-start
