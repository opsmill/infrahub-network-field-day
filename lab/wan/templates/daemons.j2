# Rendered by wan/render.py -- do not edit.
#
# The FRR image ships bgpd=no, so a stock container runs zebra and routes
# nothing. That failure is quiet: vtysh accepts `router bgp` and silently keeps
# no sessions.
zebra=yes
bgpd=yes
staticd=yes
mgmtd=yes

ospfd=no
ospf6d=no
ripd=no
ripngd=no
isisd=no
pimd=no
ldpd=no
nhrpd=no
eigrpd=no
babeld=no
sharpd=no
pbrd=no
bfdd=no
fabricd=no
vrrpd=no
pathd=no

vtysh_enable=yes
zebra_options="  -A 127.0.0.1 -s 90000000"
bgpd_options="   -A 127.0.0.1"
staticd_options="-A 127.0.0.1"
mgmtd_options="  -A 127.0.0.1"
