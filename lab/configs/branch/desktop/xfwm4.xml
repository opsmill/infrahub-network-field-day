<?xml version="1.0" encoding="UTF-8"?>
<!--
  One workspace. With the default four, a mouse wheel over the desktop switches
  workspace, and a Firefox window "vanishes" mid-demo. New windows open centred
  rather than wherever the pointer last was.

  Everything not set here keeps xfwm4's own default.
-->
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="workspace_count" type="int" value="1"/>
    <property name="scroll_workspaces" type="bool" value="false"/>
    <property name="placement_mode" type="string" value="center"/>
    <property name="placement_ratio" type="int" value="100"/>
  </property>
</channel>
